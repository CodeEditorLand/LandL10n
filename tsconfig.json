{
	"compilerOptions": {
		"baseUrl": "./",
		"declaration": true,
		"declarationMap": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"inlineSources": true,
		"module": "CommonJS",
		"noEmitOnError": false,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"outDir": "Target",
		"rootDir": "src",
		"sourceMap": true,
		"strict": true,
		"target": "ES2020"
	},
	"exclude": [
		"node_modules",
		"dist",
		"**/*.test.ts"
	],
	"extends": "@playform/build/tsconfig",
	"include": [
		"src"
	]
}
