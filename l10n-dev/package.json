{
	"author": {
		"email": "Source/Open@Editor.Land",
		"name": "Source 🖋️ Open 👐🏻",
		"url": "HTTPS://Editor.Land"
	},
	"bin": {
		"vscode-l10n-dev": "./dist/cli.js"
	},
	"bugs": {
		"url": "HTTPS://GitHub.Com/CodeEditorLand/LandL10n/issues"
	},
	"dependencies": {
		"debug": "4.4.0",
		"deepmerge-json": "1.5.0",
		"glob": "11.0.1",
		"markdown-it": "14.1.0",
		"node-html-markdown": "1.3.0",
		"pseudo-localization": "3.1.1",
		"web-tree-sitter": "0.25.3",
		"xml2js": "0.6.2",
		"yargs": "17.7.2"
	},
	"description": "Development time npm module to generate strings bundles from TypeScript files",
	"devDependencies": {
		"@playform/build": "0.2.3",
		"@types/debug": "4.1.12",
		"@types/markdown-it": "14.1.2",
		"@types/mock-fs": "4.13.4",
		"@types/node": "22.14.0",
		"@types/xml2js": "0.4.14",
		"@types/yargs": "17.0.33",
		"esbuild": "0.25.2",
		"esbuild-copy-files-plugin": "1.2.1",
		"mock-fs": "5.5.0",
		"rimraf": "6.0.1",
		"tree-sitter-cli": "0.25.3",
		"tree-sitter-typescript": "0.23.2"
	},
	"files": [
		"dist/*"
	],
	"homepage": "HTTPS://GitHub.Com/CodeEditorLand/LandL10n#readme",
	"keywords": [
		"codeeditorland",
		"land",
		"playform"
	],
	"license": "SEE LICENSE IN LICENSE",
	"main": "dist/main.js",
	"name": "@codeeditorland/l10n-dev",
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+HTTPS://github.com/CodeEditorLand/LandL10n.git"
	},
	"scripts": {
		"build-wasm": "npm run build-wasm-typescript && npm run build-wasm-tsx",
		"build-wasm-tsx": "tree-sitter build --wasm ./node_modules/tree-sitter-typescript/tsx --output ./src/ast/tree-sitter-tsx.wasm",
		"build-wasm-typescript": "tree-sitter build --wasm ./node_modules/tree-sitter-typescript/typescript --output ./src/ast/tree-sitter-typescript.wasm",
		"clean": "rimraf dist && rimraf lib",
		"compile": "npm run clean && tsc --emitDeclarationOnly --outDir lib && node .esbuild.config.mjs",
		"prepublishOnly": "Build 'Source/**/*.ts'"
	},
	"type": "module",
	"types": "dist/main.d.ts",
	"version": "0.0.1"
}
